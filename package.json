{
  "name": "slot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3050",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3050",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo": "node scripts/demo.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "studio:create": "tsx scripts/create-studio.ts"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.48.0",
    "zod": "4.6.5",
    "pg": "8.23.0",
    "@node-rs/argon2": "2.2.1",
    "@js-temporal/polyfill": "0.5.1",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "prettier": "3.9.9",
    "vitest": "5.0.2",
    "@playwright/test": "1.63.0",
    "tsx": "4.23.15",
    "dotenv": "18.0.4",
    "@types/pg": "8.23.1",
    "@electric-sql/pglite": "0.5.8"
  }
}
