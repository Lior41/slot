# Local single-process demo. Use DB_DRIVER=postgres with DATABASE_URL for hosting.
DB_DRIVER=pglite
DB_PATH=.local/embedded
DATABASE_URL=postgresql://slot:slot@localhost:5432/slot
APP_ORIGIN=http://localhost:3050
DEMO_MODE=true
# Test mode only; never commit credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional email delivery: demo workspaces never send messages.
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
# Provisioning variables are documented in docs/DEPLOYMENT.md.
